{
  "name": "sismicidad",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "build": {
    "command": "npm ci --prefix frontend-react && npm run build --prefix frontend-react"
  },
  "assets": {
    "directory": "./frontend-react/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "DATOS",
      "id": "dff12494a72f435889ca1e30af8b0cb1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sismicidad-lecturas",
      "database_id": "efb5c3b7-b1e4-4ca9-979f-46e5bb4a0a4f"
    }
  ]
}
